__pycache__/

# The JUnit report both CI files ask pytest for; also lands here when the CI command is
# reproduced locally.
report.xml

# Tool caches from the fast loop.
.pytest_cache/
.ruff_cache/

# The dev Python of the two environments in docs/development.md. Slicer's Python is the
# other one and lives inside the Slicer install, so only this side ever lands in the tree.
.venv/

# Annotations saved while trying the module out. The module writes FCSV beside whatever
# volume is open, so a trial run would otherwise show up as a change to the repository.
*.fcsv

# Finder metadata, which appears in any directory an annotator browses to.
.DS_Store
